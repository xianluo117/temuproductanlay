# Server
PORT=3100
HOST=0.0.0.0
DATA_DIR=../../data
WEB_DIST_DIR=../web/dist
MAX_UPLOAD_MB=50
IMAGE_DOWNLOAD_TIMEOUT_MS=10000

# CloakBrowser Worker
# 默认保存到项目 data/browser，可改为相对于 apps/server 的路径或绝对路径。
BROWSER_DATA_DIR=../../data/browser
BROWSER_WORKER_PYTHON=python
BROWSER_WORKER_SCRIPT=../browser-worker/worker.py

# 智猴 ERP 协议工作器
ZHIHOU_WORKER_PYTHON=python
ZHIHOU_WORKER_SCRIPT=../browser-worker/zhihou_worker.py
ZHIHOU_REQUEST_TIMEOUT_MS=30000
ZHIHOU_LOGIN_MAX_ATTEMPTS=8
# 可选：32 字节随机密钥的 Base64 编码，用于 AES-256-GCM 加密智猴密码。
# 留空时首次保存账号会在 data/security 自动生成本机密钥文件。
# 如需迁移服务器，应随数据备份安全迁移该密钥，或显式配置固定密钥。
ZHIHOU_CREDENTIAL_KEY=
# 可选：Tesseract 未加入 PATH 时填写绝对路径。
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
